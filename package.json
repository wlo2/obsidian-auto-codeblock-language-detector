{
  "name": "auto-codeblock-language-detector",
  "version": "0.6.0",
  "description": "Obsidian plugin that detects languages for pasted and existing fenced code blocks.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc && node esbuild.config.mjs production",
    "test": "node --test test/",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "plugin",
    "codeblock",
    "language-detection"
  ],
  "author": "wlo2",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@types/node": "^22.15.18",
    "esbuild": "^0.25.3",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0"
  }
}
